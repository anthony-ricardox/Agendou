<%= render "shared/errors", record: service %>

<%= form_with model: service, class: "space-y-5" do |form| %>
  <div>
    <%= form.label :name, "Nome do serviço", class: label_classes %>
    <%= form.text_field :name, placeholder: "Ex.: Corte de cabelo", required: true, class: input_classes %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :duration_minutes, "Duração (min)", class: label_classes %>
      <%= form.number_field :duration_minutes, min: 1, step: 5, required: true, class: input_classes %>
    </div>

    <div>
      <%= form.label :price, "Preço (R$)", class: label_classes %>
      <%= form.number_field :price, min: 0, step: 0.01, required: true, class: input_classes %>
    </div>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= form.submit "Salvar", class: primary_button_classes %>
    <%= link_to "Cancelar", services_path, class: secondary_button_classes %>
  </div>
<% end %>