<h1>Novo serviço</h1>

<%= form_with model: @service do |form| %>
  <div>
    <%= form.label :name, "Nome do serviço" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :duration_minutes, "Duração (minutos)" %>
    <%= form.number_field :duration_minutes %>
  </div>

  <div>
    <%= form.label :price, "Preço" %>
    <%= form.number_field :price, step: 0.01 %>
  </div>

  <%= form.submit "Salvar" %>
<% end %>