<div>
  <div class="flex items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Meus serviços</h1>
      <p class="mt-1 text-slate-500">O que você oferece aos clientes.</p>
    </div>
    <%= link_to "Novo serviço", new_service_path, class: "shrink-0 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500" %>
  </div>

  <% if @services.any? %>
    <ul class="mt-8 divide-y divide-slate-100 rounded-2xl border border-slate-200 bg-white shadow-sm">
      <% @services.each do |service| %>
        <li class="flex items-center justify-between gap-4 p-5">
          <div class="min-w-0">
            <p class="truncate font-medium text-slate-900"><%= service.name %></p>
            <p class="mt-0.5 text-sm text-slate-500">
              <%= service.duration_minutes %> min ·
              <%= number_to_currency(service.price) %>
            </p>
          </div>

          <div class="flex shrink-0 items-center gap-2">
            <%= link_to "Editar", edit_service_path(service), class: "rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50" %>
            <%= button_to "Remover", service_path(service), method: :delete,
                  form: { data: { turbo_confirm: "Remover este serviço? Os agendamentos dele também serão apagados." } },
                  class: "cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:border-rose-300 hover:bg-rose-50 hover:text-rose-700" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center">
      <p class="font-medium text-slate-900">Nenhum serviço cadastrado</p>
      <p class="mt-1 text-sm text-slate-500">Cadastre o primeiro para que clientes possam agendar com você.</p>
      <%= link_to "Cadastrar serviço", new_service_path, class: "mt-5 inline-block rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-500" %>
    </div>
  <% end %>
</div>