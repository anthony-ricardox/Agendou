<h1>Meus serviços</h1>

<%= link_to "Novo serviço", new_service_path %>

<ul>
  <% @services.each do |service| %>
    <li>
      <%= service.name %> — <%= service.duration_minutes %> min — R$ <%= service.price %>
      <%= link_to "Editar", edit_service_path(service) %>
      <%= button_to "Remover", service_path(service), method: :delete %>
    </li>
  <% end %>
</ul>