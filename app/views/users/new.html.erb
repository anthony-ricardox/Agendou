<div class="mx-auto max-w-md">
  <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Criar conta</h1>
    <p class="mt-1 text-sm text-slate-500">Leva menos de um minuto.</p>

    <% if @user.errors.any? %>
      <div class="mt-6 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
        <ul class="list-disc space-y-1 pl-5">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, class: "mt-6 space-y-5" do |form| %>
      <div>
        <%= form.label :name, "Nome", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :name,
              autocomplete: "name",
              required: true,
              class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/10" %>
      </div>

      <div>
        <%= form.label :email, "Email", class: "block text-sm font-medium text-slate-700" %>
        <%= form.email_field :email,
              placeholder: "voce@exemplo.com",
              autocomplete: "email",
              required: true,
              class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/10" %>
      </div>

      <div>
        <%= form.label :password, "Senha", class: "block text-sm font-medium text-slate-700" %>
        <%= form.password_field :password,
              autocomplete: "new-password",
              required: true,
              minlength: 6,
              class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/10" %>
        <p class="mt-1.5 text-xs text-slate-500">Mínimo de 6 caracteres.</p>
      </div>

      <div>
        <%= form.label :password_confirmation, "Confirmar senha", class: "block text-sm font-medium text-slate-700" %>
        <%= form.password_field :password_confirmation,
              autocomplete: "new-password",
              required: true,
              class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/10" %>
      </div>

      <%= form.submit "Criar conta",
            class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/30" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-slate-500">
      Já tem conta?
      <%= link_to "Entrar", new_session_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
    </p>
  </div>
</div>