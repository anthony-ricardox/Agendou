<div>
  <%= link_to "← Voltar para prestadores", providers_path, class: "text-sm font-medium text-slate-500 hover:text-indigo-600" %>

  <div class="mt-4 flex items-center gap-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-2xl font-semibold text-indigo-700">
      <%= @provider.user.name[0].upcase %>
    </div>
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900"><%= @provider.user.name %></h1>
      <p class="mt-1 text-slate-500"><%= @provider.bio.presence || "Sem descrição ainda." %></p>
    </div>
  </div>

  <h2 class="mt-10 text-lg font-semibold text-slate-900">Serviços</h2>

  <% if @services.any? %>
    <ul class="mt-4 divide-y divide-slate-100 rounded-2xl border border-slate-200 bg-white shadow-sm">
      <% @services.each do |service| %>
        <li class="flex items-center justify-between gap-4 p-5">
          <div>
            <p class="font-medium text-slate-900"><%= service.name %></p>
            <p class="mt-0.5 text-sm text-slate-500">
              <%= service.duration_minutes %> min ·
              <%= number_to_currency(service.price, unit: "R$ ", separator: ",", delimiter: ".") %>
            </p>
          </div>
          <%= link_to "Agendar", new_appointment_path(service_id: service.id), class: "shrink-0 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-4 rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
      <p class="text-sm text-slate-500">Este prestador ainda não cadastrou serviços.</p>
    </div>
  <% end %>
</div>