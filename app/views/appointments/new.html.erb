<% dias = %w[domingo segunda-feira terça-feira quarta-feira quinta-feira sexta-feira sábado] %>

<div>
  <%= link_to "← Voltar", public_provider_path(@service.provider), class: "text-sm font-medium text-slate-500 hover:text-indigo-600" %>

  <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <p class="text-sm font-medium text-indigo-600">Agendar horário</p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900"><%= @service.name %></h1>
    <p class="mt-1 text-sm text-slate-500">
      com <%= @service.provider.user.name %> ·
      <%= @service.duration_minutes %> min ·
      <%= number_to_currency(@service.price, unit: "R$ ", separator: ",", delimiter: ".") %>
    </p>
  </div>

  <h2 class="mt-10 text-lg font-semibold text-slate-900">Escolha um horário</h2>

  <% if @available_slots.any? %>
    <div class="mt-4 space-y-4">
      <% @available_slots.group_by(&:to_date).each do |data, horarios| %>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="text-sm font-semibold text-slate-900">
            <%= dias[data.wday].capitalize %>
            <span class="font-normal text-slate-500">· <%= data.strftime("%d/%m") %></span>
          </h3>

          <div class="mt-3 flex flex-wrap gap-2">
            <% horarios.each do |horario| %>
              <%= button_to horario.strftime("%H:%M"), appointments_path,
                    params: { service_id: @service.id, starts_at: horario.iso8601 },
                    class: "cursor-pointer rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 transition hover:border-indigo-500 hover:bg-indigo-50 hover:text-indigo-700" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="mt-4 rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center">
      <p class="font-medium text-slate-900">Nenhum horário livre nos próximos 7 dias</p>
      <p class="mt-1 text-sm text-slate-500">Volte mais tarde ou escolha outro prestador.</p>
    </div>
  <% end %>
</div>