<div>
  <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Minha agenda</h1>
  <p class="mt-1 text-slate-500">Os clientes que agendaram com você.</p>

  <% if @appointments.any? %>
    <ul class="mt-8 divide-y divide-slate-100 rounded-2xl border border-slate-200 bg-white shadow-sm">
      <% @appointments.each do |appointment| %>
        <li class="flex items-center justify-between gap-4 p-5 <%= "opacity-60" if appointment.cancelled? %>">
          <div class="flex min-w-0 items-center gap-4">
            <div class="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-xl bg-slate-100">
              <span class="text-xs font-medium uppercase text-slate-500"><%= l(appointment.starts_at.to_date, format: "%b") %></span>
              <span class="text-lg font-semibold leading-none text-slate-900"><%= appointment.starts_at.day %></span>
            </div>

            <div class="min-w-0">
              <p class="truncate font-medium text-slate-900"><%= appointment.user.name %></p>
              <p class="mt-0.5 truncate text-sm text-slate-500">
                <%= appointment.service.name %> · <%= appointment.starts_at.strftime("%H:%M") %> às <%= appointment.ends_at.strftime("%H:%M") %>
              </p>
            </div>
          </div>

          <%= status_badge(appointment) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center">
      <p class="font-medium text-slate-900">Nenhum agendamento recebido ainda</p>
      <p class="mt-1 text-sm text-slate-500">Quando um cliente marcar um horário com você, ele aparece aqui.</p>
    </div>
  <% end %>
</div>