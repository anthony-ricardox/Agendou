<div>
  <div class="flex items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Meus agendamentos</h1>
      <p class="mt-1 text-slate-500">Os horários que você marcou como cliente.</p>
    </div>
    <%= link_to "Novo agendamento", public_providers_path, class: "shrink-0 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500" %>
  </div>

  <% if @appointments.any? %>
    <ul class="mt-8 divide-y divide-slate-100 rounded-2xl border border-slate-200 bg-white shadow-sm">
      <% @appointments.each do |appointment| %>
        <li class="flex items-center justify-between gap-4 p-5 <%= "opacity-60" if appointment.cancelled? %>">
          <div class="flex min-w-0 items-center gap-4">
            <div class="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-xl bg-slate-100">
              <span class="text-xs font-medium uppercase text-slate-500"><%= l(appointment.starts_at.to_date, format: "%b") %></span>
              <span class="text-lg font-semibold leading-none text-slate-900"><%= appointment.starts_at.day %></span>
            </div>

            <div class="min-w-0">
              <p class="truncate font-medium text-slate-900"><%= appointment.service.name %></p>
              <p class="mt-0.5 truncate text-sm text-slate-500">
                com <%= appointment.service.provider.user.name %> · <%= appointment.starts_at.strftime("%H:%M") %> às <%= appointment.ends_at.strftime("%H:%M") %>
              </p>
            </div>
          </div>

          <div class="flex shrink-0 items-center gap-3">
            <%= status_badge(appointment) %>

            <% if appointment.pending? || appointment.confirmed? %>
              <%= button_to "Cancelar", appointment_path(appointment), method: :delete,
                    form: { data: { turbo_confirm: "Cancelar este agendamento?" } },
                    class: "cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:border-rose-300 hover:bg-rose-50 hover:text-rose-700" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center">
      <p class="font-medium text-slate-900">Você ainda não tem agendamentos</p>
      <p class="mt-1 text-sm text-slate-500">Escolha um prestador e marque seu primeiro horário.</p>
      <%= link_to "Ver prestadores", public_providers_path, class: "mt-5 inline-block rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-500" %>
    </div>
  <% end %>
</div>