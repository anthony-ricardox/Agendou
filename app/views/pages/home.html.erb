<% if current_user %>
  <div>
    <h1 class="text-3xl font-semibold tracking-tight text-slate-900">
      Olá, <%= current_user.name.split.first %> 👋
    </h1>
    <p class="mt-1 text-slate-500">O que você quer fazer hoje?</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <%= link_to providers_path, class: "group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-indigo-300 hover:shadow-md" do %>
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-50 text-lg">🔍</div>
        <h2 class="mt-4 font-semibold text-slate-900 group-hover:text-indigo-600">Encontrar um prestador</h2>
        <p class="mt-1 text-sm text-slate-500">Veja quem atende e agende um horário livre.</p>
      <% end %>

      <%= link_to appointments_path, class: "group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-indigo-300 hover:shadow-md" do %>
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-50 text-lg">📅</div>
        <h2 class="mt-4 font-semibold text-slate-900 group-hover:text-indigo-600">Meus agendamentos</h2>
        <p class="mt-1 text-sm text-slate-500">Consulte ou cancele o que você marcou.</p>
      <% end %>

      <% if current_user.provider.present? %>
        <%= link_to schedule_appointments_path, class: "group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-indigo-300 hover:shadow-md" do %>
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-50 text-lg">🗓️</div>
          <h2 class="mt-4 font-semibold text-slate-900 group-hover:text-indigo-600">Minha agenda</h2>
          <p class="mt-1 text-sm text-slate-500">Veja quem agendou com você.</p>
        <% end %>
      <% else %>
        <%= link_to new_provider_path, class: "group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-indigo-300 hover:shadow-md" do %>
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-50 text-lg">✨</div>
          <h2 class="mt-4 font-semibold text-slate-900 group-hover:text-indigo-600">Oferecer serviços</h2>
          <p class="mt-1 text-sm text-slate-500">Torne-se prestador e receba agendamentos.</p>
        <% end %>
      <% end %>
    </div>
  </div>
<% else %>
  <section class="py-12 text-center">
    <span class="inline-flex items-center rounded-full bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">
      Agendamento sem conflito de horários
    </span>
    <h1 class="mx-auto mt-6 max-w-2xl text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">
      Marque horários sem a troca infinita de mensagens
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-slate-500">
      Prestadores definem quando atendem. Clientes escolhem um horário livre. O Agendou garante que ninguém marca em cima de ninguém.
    </p>
    <div class="mt-8 flex items-center justify-center gap-3">
      <%= link_to "Criar conta grátis", new_user_path, class: "rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500" %>
      <%= link_to "Já tenho conta", new_session_path, class: "rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
    </div>
  </section>

  <section class="grid gap-4 pt-8 sm:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-6">
      <div class="text-2xl">🗓️</div>
      <h2 class="mt-3 font-semibold text-slate-900">Defina sua disponibilidade</h2>
      <p class="mt-1 text-sm text-slate-500">Escolha dias e horários em que você atende.</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-6">
      <div class="text-2xl">⚡</div>
      <h2 class="mt-3 font-semibold text-slate-900">Horários calculados na hora</h2>
      <p class="mt-1 text-sm text-slate-500">O cliente só vê o que realmente está livre.</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-6">
      <div class="text-2xl">🛡️</div>
      <h2 class="mt-3 font-semibold text-slate-900">Zero duplo agendamento</h2>
      <p class="mt-1 text-sm text-slate-500">Conflitos são barrados direto no banco.</p>
    </div>
  </section>
<% end %>