<body>
  <nav>
    <%= link_to "Agendou", root_path %>

    <% if current_user %>
      <% if current_user.provider.present? %>
        <%= link_to "Meus serviços", services_path %>
        <%= link_to "Minha disponibilidade", availabilities_path %>
        <%= link_to "Minha agenda", schedule_appointments_path %>
      <% else %>
        <%= link_to "Tornar-se prestador", new_provider_path %>
      <% end %>

      <%= link_to "Prestadores", providers_path %>
      <%= link_to "Meus agendamentos", appointments_path %>
      <%= button_to "Sair", session_path, method: :delete %>
    <% else %>
      <%= link_to "Entrar", new_session_path %>
    <% end %>
  </nav>

  <% if flash[:notice] %>
    <p style="color: green;"><%= flash[:notice] %></p>
  <% end %>

  <% if flash[:alert] %>
    <p style="color: red;"><%= flash[:alert] %></p>
  <% end %>

  <%= yield %>
</body>