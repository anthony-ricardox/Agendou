<h1>Nova disponibilidade</h1>

<%= form_with model: @availability do |form| %>
  <div>
    <%= form.label :day_of_week, "Dia da semana" %>
    <%= form.select :day_of_week, options_for_select(Date::DAYNAMES.each_with_index.map { |name, i| [name, i] }) %>
  </div>

  <div>
    <%= form.label :start_time, "Início" %>
    <%= form.time_field :start_time %>
  </div>

  <div>
    <%= form.label :end_time, "Fim" %>
    <%= form.time_field :end_time %>
  </div>

  <%= form.submit "Salvar" %>
<% end %>