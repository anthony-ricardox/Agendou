<div>
  <div class="flex items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Minha disponibilidade</h1>
      <p class="mt-1 text-slate-500">Os dias e horários em que você atende.</p>
    </div>
    <%= link_to "Nova disponibilidade", new_availability_path, class: "shrink-0 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500" %>
  </div>

  <% if @availabilities.any? %>
    <ul class="mt-8 divide-y divide-slate-100 rounded-2xl border border-slate-200 bg-white shadow-sm">
      <% @availabilities.each do |availability| %>
        <li class="flex items-center justify-between gap-4 p-5">
          <div>
            <p class="font-medium text-slate-900"><%= day_name(availability.day_of_week) %></p>
            <p class="mt-0.5 text-sm text-slate-500">
              <%= availability.start_time.strftime("%H:%M") %> às <%= availability.end_time.strftime("%H:%M") %>
            </p>
          </div>

          <div class="flex shrink-0 items-center gap-2">
            <%= link_to "Editar", edit_availability_path(availability), class: "rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50" %>
            <%= button_to "Remover", availability_path(availability), method: :delete,
                  form: { data: { turbo_confirm: "Remover esta disponibilidade?" } },
                  class: "cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:border-rose-300 hover:bg-rose-50 hover:text-rose-700" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center">
      <p class="font-medium text-slate-900">Nenhuma disponibilidade cadastrada</p>
      <p class="mt-1 text-sm text-slate-500">Defina os dias e horários em que você atende para que clientes possam agendar.</p>
    </div>
  <% end %>
</div>